generator client {
  provider      = "prisma-client-js"
  engineType    = "binary"
  binaryTargets = ["native", "rhel-openssl-1.1.x"]
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Product {
  id               String           @id @default(cuid())
  name             String           @db.Text
  slug             String           @unique
  shortDescription String           @db.Text
  description      String           @db.Text
  imageUrl         String           @db.LongText
  additionalImages String           @default("[]") @db.LongText
  basePrice        Int              // In paise (1 INR = 100 paise)
  originalPrice    Int?             // In paise
  sku              String           @unique
  category         String           @db.Text
  stockQuantity    Int              @default(0)
  lowStockThreshold Int             @default(5)
  isAvailable      Boolean          @default(true)
  isFeatured       Boolean          @default(false)
  tags             String           @default("[]") @db.Text
  highlights       String?          @db.Text
  ingredients      String?          @db.Text
  nutritionalInfo  String?          @db.Text
  storage          String?          @db.Text
  allergens        String?          @db.Text
  deliveryNotes    String?          @db.Text
  seoTitle         String?          @db.Text
  seoDesc          String?          @db.Text
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  variants         ProductVariant[]
  orderItems       OrderItem[]
  reviews          ProductReview[]
  comments         ProductComment[]
}

model ProductVariant {
  id               String      @id @default(cuid())
  productId        String
  product          Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  name             String      @db.Text // e.g., "250g", "500g"
  packSize         String      @db.Text
  price            Int         // In paise
  originalPrice    Int?        // In paise
  stockQuantity    Int         @default(0)
  isAvailable      Boolean     @default(true)
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt
}

model Order {
  id               String      @id @default(cuid())
  orderNumber      String      @unique // e.g., PF-2026-00001
  customerName     String
  customerPhone    String
  customerId       String?
  customer         Customer? @relation(fields: [customerId], references: [id])
  addressLine1     String      @db.Text
  addressLine2     String?     @db.Text
  city             String
  state            String
  pinCode          String
  deliveryInstructions String? @db.Text
  subtotal         Int         // In paise
  deliveryFee      Int         // In paise
  discount         Int         @default(0)
  couponCode       String?
  totalAmount      Int         // In paise

  paymentStatus    String      @default("PENDING") // PENDING, PAID, FAILED, REFUNDED
  paymentMethod    String      @default("RAZORPAY")
  fulfillmentStatus String     @default("PENDING") // PENDING, PROCESSING, PACKED, SHIPPED, OUT_FOR_DELIVERY, DELIVERED, CANCELLED

  trackingNumber   String?     // AWB / Consignment tracking number
  carrierName      String?     // Courier partner details (e.g. Delhivery, Blue Dart, etc.)
  trackingUrl      String?     @db.Text // Custom tracking URL (or auto-resolved)

  gatewayOrderId   String?
  gatewayPaymentId String?

  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  items            OrderItem[]
}

model Customer {
  id        String   @id @default(cuid())
  email     String   @unique @db.VarChar(254)
  name      String
  passwordHash String?
  phone     String?
  dob       String?
  gender    String?
  dietaryPreferences String @default("[]") @db.Text
  preferences String @default("{}") @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  addresses CustomerAddress[]
  orders    Order[]
  productReviews ProductReview[]
  productComments ProductComment[]
}

model ProductReview {
  id         String   @id @default(cuid())
  productId  String
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  rating     Int
  content    String   @db.Text
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([productId, customerId])
  @@index([productId, createdAt])
}

model ProductComment {
  id         String   @id @default(cuid())
  productId  String
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  content    String   @db.Text
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([productId, createdAt])
  @@index([customerId, createdAt])
}

model CustomerAddress {
  id            String   @id @default(cuid())
  customerId    String
  customer      Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  label         String
  fullName      String
  phone         String
  addressLine1  String   @db.Text
  addressLine2  String?  @db.Text
  city          String
  state         String
  pinCode       String
  isDefault     Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model OtpChallenge {
  id        String   @id @default(cuid())
  email     String   @db.VarChar(254)
  purpose   String?
  customerName String?
  passwordHash String?
  codeHash  String
  expiresAt DateTime
  attempts  Int      @default(0)
  createdAt DateTime @default(now())
  @@index([email, createdAt])
}

model OrderItem {
  id               String      @id @default(cuid())
  orderId          String
  order            Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId        String?
  variantId        String?
  product          Product?    @relation(fields: [productId], references: [id], onDelete: SetNull)
  productName      String?     @db.Text
  productSlug      String?
  productImageUrl  String?     @db.Text
  variantName      String?     @db.Text
  quantity         Int
  unitPrice        Int         // In paise
  subtotal         Int         // In paise
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt
}

model StoreSettings {
  id                  String   @id @default("default")
  storeName           String   @default("Pink Farm") @db.Text
  announcementText    String   @default("Welcome to Pink Farm — Goodness in Every Bite.") @db.Text
  bottomAnnouncementText String @default("Welcome to Pink Farm — Goodness in Every Bite.") @db.Text
  bottomAnnouncementEnabled Boolean @default(true)
  heroMainImage       String?  @db.LongText
  heroGheeImage       String?  @db.LongText
  heroAlmondsImage    String?  @db.LongText
  heroVideo           String?  @db.LongText
  heroVideoOpacity    Int?     @default(55)
  heartProductId      String?
  heartProductTitle   String   @default("Premium Phool Makhana") @db.Text
  heartProductTagline String   @default("Why not? You deserve the best.") @db.Text
  heartProductFeatures Json @default("[\"Plant-Based\",\"Gluten-Free\",\"Low Calorie\",\"High Calcium\",\"No Frying\",\"No Preservatives\",\"Farm to Table\",\"Hygienically Packed\"]")
  heartProductButtonText String @default("Shop Now")
  heartProductButtonUrl  String? @db.Text
  heartProductSubtitle   String @default("Our Heart Product") @db.Text
  heartProductImage      String? @db.LongText
  featuredProductId   String?
  featuredProductHeading String @default("Meet Your New Favourite Snack.") @db.Text
  featuredProductDescription String @default("Handpicked, light & wholesome") @db.Text
  featuredProductImage String? @db.LongText
  featuredProductButtonText String @default("View Details & Add to Cart")
  founderName String @default("Anjali")
  founderImage String? @db.LongText
  founderRole String @default("Founder & Dietitian")
  founderStoryFirst String @default("Anjali started her journey as a trained dietitian — someone who spent years understanding the deep connection between what we eat and how we feel. She knew that truly good food doesn't need artificial anything. It just needs care, intention, and the right source.") @db.Text
  founderStorySecond String @default("That belief became the seed of Pink Farm. What began as a personal mission to bring honest, nutritious snacks to her own family soon turned into something much bigger — a food brand built on trust, quality, and a quiet promise to never cut corners.") @db.Text
  founderQuote String @default("Pure in nature, good for you. Simple food, stronger you.") @db.Text
  founderTags Json @default("[\"Nutrition\",\"Food Science\",\"Innovation\",\"Entrepreneur\",\"Founder\",\"Curator\"]")
  supportPhone        String   @default("+91 8437504040")
  supportEmail        String   @default("wecare@pinkfarm.in") @db.VarChar(254)
  businessAddress     String   @default("Dugri, Ludhiana, Punjab - 141003") @db.Text
  fssaiNumber         String   @default("22126026000144")
  deliveryFee         Int      @default(5000) // 50 INR in paise
  freeDeliveryThreshold Int?   @default(50000) // 500 INR
  isAcceptingOrders   Boolean  @default(true)
  // Combo Builder Settings
  comboEnabled        Boolean  @default(true)
  comboEyebrow        String   @default("Make Your Own Combo")
  comboTitlePrefix    String   @default("Curate Your")
  comboTitleHighlight String   @default("Pink Farm Combo")
  comboSubtitle       String   @default("Mix & match your favourite flavoured makhanas. Add multiple packs of any flavour — combo discounts apply directly on the original MRP!") @db.Text
  comboTier1Count     Int      @default(3)
  comboTier1Discount  Int      @default(11) // percentage
  comboTier1Label     String   @default("Trio Combo")
  comboTier1Tagline   String   @default("Pick any 3 — save 11% on MRP")
  comboTier1Badge     String   @default("✦ 11% OFF")
  comboTier1Emoji     String   @default("🌿")
  comboTier2Count     Int      @default(5)
  comboTier2Discount  Int      @default(15) // percentage
  comboTier2Label     String   @default("Penta Combo")
  comboTier2Tagline   String   @default("Pick any 5 — save 15% on MRP")
  comboTier2Badge     String   @default("✦ 15% OFF")
  comboTier2Emoji     String   @default("🌸")
  comboButtonText     String   @default("Shop My Combo")
  comboFooterNote     String   @default("✦ Combo discount applies to total MRP ✦ Multiples allowed ✦") @db.Text
  comboProductIds     Json @default("[]")
  storeCategories     Json @default("[\"Makhana\",\"Nuts\",\"Pantry\"]")
  updatedAt           DateTime @updatedAt
}

model Coupon {
  id                String   @id @default(cuid())
  code              String   @unique
  discountType      String   // FIXED or PERCENTAGE
  discountValue     Int      // Fixed discounts in paise; percentage as whole percent
  minimumSubtotal   Int      @default(0) // paise
  maximumDiscount   Int?     // paise; used for percentage discounts
  startsAt          DateTime @default(now())
  expiresAt         DateTime?
  isActive          Boolean  @default(true)
  usageLimit        Int?
  usedCount         Int      @default(0)
  perCustomerLimit  Int?
  firstOrderOnly    Boolean  @default(false)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

model AdminUser {
  id        String   @id @default(cuid())
  email     String   @unique @db.VarChar(254)
  password  String   // Hashed
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model AuthRateLimit {
  id        String   @id @default(cuid())
  key       String   @unique
  count     Int      @default(0)
  resetAt   DateTime
  updatedAt DateTime @updatedAt

  @@index([resetAt])
}
